## Armor Mod System

# Slot names (shown in examine)
armor-mod-slot-name-1 = Mod slot 1
armor-mod-slot-name-2 = Mod slot 2
armor-mod-slot-name-3 = Mod slot 3

# Lock/unlock popups (shown when using a screwdriver)
armor-mod-slots-locked = Mod slots locked.
armor-mod-slots-unlocked = Mod slots unlocked.

# Examine text (shown immediately on inspect)
armor-mod-examine-locked = [color=red]Mod slots: LOCKED (use screwdriver to unlock)[/color]
armor-mod-examine-unlocked = [color=green]Mod slots: UNLOCKED (use screwdriver to lock)[/color]
armor-mod-examine-header = [color=white]Installed modifications:[/color]
armor-mod-slot-empty = [color=gray]  { $slot }: empty[/color]
armor-mod-slot-filled = [color=gray]  { $slot }:[/color] [color=cyan]{ $mod }[/color]
armor-mod-stat-header = [color=white]Provides the following bonuses:[/color]
