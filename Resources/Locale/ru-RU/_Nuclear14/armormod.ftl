## Система модификаций брони

# Названия слотов (отображаются при осмотре)
armor-mod-slot-name-1 = Слот мода 1
armor-mod-slot-name-2 = Слот мода 2
armor-mod-slot-name-3 = Слот мода 3

# Попапы блокировки/разблокировки (при использовании отвёртки)
armor-mod-slots-locked = Слоты модов заблокированы.
armor-mod-slots-unlocked = Слоты модов разблокированы.

# Текст осмотра (показывается сразу при examine)
armor-mod-examine-locked = [color=red]Слоты модов: ЗАБЛОКИРОВАНЫ (используйте отвёртку)[/color]
armor-mod-examine-unlocked = [color=green]Слоты модов: разблокированы (отвёртка — заблокировать)[/color]
armor-mod-examine-header = [color=white]Установленные модификации:[/color]
armor-mod-slot-empty = [color=gray]  { $slot }: пусто[/color]
armor-mod-slot-filled = [color=gray]  { $slot }:[/color] [color=cyan]{ $mod }[/color]

## Названия предметов-модов

ent-N14ArmorModBase = мод брони
    .desc = Модификация для силовой брони.

ent-N14ArmorModTitaniumPlating = титановые пластины
    .desc = Усиленные титановые пластины. Улучшают устойчивость брони к дробящему, режущему и колющему урону.

ent-N14ArmorModHDPELining = ПЭВП-подкладка
    .desc = Подкладка из полиэтилена высокой плотности. Улучшает радиационную защиту.

ent-N14ArmorModCeramicPlate = керамические пластины
    .desc = Керамические пластины, улучшающие устойчивость к тепловому и химическому урону.

ent-N14ArmorModShockAbsorbers = амортизаторы
    .desc = Гидравлические амортизаторы, снижающие урон от дробящих ударов и взрывов.
