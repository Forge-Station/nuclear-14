<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     MinSize="300 260"
                     Title="{Loc 'quest-board-title'}">
    <BoxContainer Orientation="Vertical" Margin="8">

        <!-- Status line -->
        <Label Name="StatusLabel"
               Text=""
               HorizontalAlignment="Center"
               Margin="0 0 0 6"/>

        <controls:HLine Color="#404040" Thickness="1" Margin="0 0 0 8"/>

        <!-- CREATE — visible when no active instance -->
        <BoxContainer Name="CreateBox" Orientation="Vertical">
            <Label Text="{Loc 'quest-board-select-difficulty'}"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 6"/>
            <Button Name="EasyButton"
                    Text="{Loc 'quest-board-easy'}"
                    HorizontalExpand="True"
                    Margin="4 2"/>
            <Button Name="MediumButton"
                    Text="{Loc 'quest-board-medium'}"
                    HorizontalExpand="True"
                    Margin="4 2"/>
            <Button Name="HardButton"
                    Text="{Loc 'quest-board-hard'}"
                    HorizontalExpand="True"
                    Margin="4 2"/>
        </BoxContainer>

        <!-- JOIN — visible when instance already active -->
        <BoxContainer Name="JoinBox" Orientation="Vertical" Visible="False">
            <Label Text="{Loc 'quest-board-instance-active'}"
                   HorizontalAlignment="Center"
                   Margin="0 0 0 6"/>
            <Button Name="JoinButton"
                    Text="{Loc 'quest-board-join'}"
                    HorizontalExpand="True"
                    Margin="4 2"/>
        </BoxContainer>

    </BoxContainer>
</controls:FancyWindow>
