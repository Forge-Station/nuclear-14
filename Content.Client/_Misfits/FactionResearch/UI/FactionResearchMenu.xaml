<controls:FancyWindow xmlns="https://spacestation14.io"
                     xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                     xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                     Title="{Loc 'faction-research-title'}"
                     MinWidth="820"
                     MinHeight="560"
                     StyleClasses="WindowLarge">
    <BoxContainer Orientation="Vertical"
                  SeparationOverride="0"
                  StyleClasses="PanelBackgroundBase"
                  HorizontalExpand="True"
                  VerticalExpand="True">
        <PanelContainer Margin="4 4 4 0" MinHeight="52" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="10 8 10 8" SeparationOverride="8">
                <Label Name="PointsLabel" StyleClasses="LabelHeading" HorizontalExpand="True" VerticalAlignment="Center"/>
            </BoxContainer>
        </PanelContainer>
        <PanelContainer Margin="4 4 4 4" VerticalExpand="True" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True" SeparationOverride="8" Margin="8">
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="1">
                    <Label Text="{Loc 'faction-research-prints'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                        </PanelContainer.PanelOverride>
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer Name="PrintList" Orientation="Vertical" HorizontalExpand="True"/>
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>
                <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True" SizeFlagsStretchRatio="1" SeparationOverride="6">
                    <Label Text="{Loc 'faction-research-disks'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
                    <BoxContainer Name="DiskRow" Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="4">
                        <Button Name="Disk500" Text="500" HorizontalExpand="True"/>
                        <Button Name="Disk1000" Text="1000" HorizontalExpand="True"/>
                        <Button Name="Disk2500" Text="2500" HorizontalExpand="True"/>
                        <Button Name="Disk5000" Text="5000" HorizontalExpand="True"/>
                    </BoxContainer>
                    <Label Text="{Loc 'faction-research-convert'}" StyleClasses="LabelHeading" HorizontalAlignment="Center"/>
                    <PanelContainer VerticalExpand="True">
                        <PanelContainer.PanelOverride>
                            <graphics:StyleBoxFlat BackgroundColor="#1B1B1E"/>
                        </PanelContainer.PanelOverride>
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer Name="ConvertList" Orientation="Vertical" HorizontalExpand="True"/>
                        </ScrollContainer>
                    </PanelContainer>
                </BoxContainer>
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
