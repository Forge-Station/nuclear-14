<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="300 300"
                      Resizable="False">
    <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="4 4 4 4">
        <Label Text="{Loc 'capture-point-owner-static-label'}" />
        <TextureRect Name="OwnerFlagTexture" Stretch="KeepAspectCentered" SetHeight="64" HorizontalAlignment="Center" />
        <BoxContainer Orientation="Horizontal">
            <Label Text="{Loc 'capture-point-timer-payout-label'}" />
            <Label Name="PayoutTimerValueLabel" />
        </BoxContainer>
        <Button Name="CaptureButton" Text="{Loc 'capture-point-button'}" />
        <Label Text="{Loc 'capture-point-timer-capture-label'}" />
        <ProgressBar Name="CooldownBar" MinValue="0" MaxValue="1" SetHeight="16" />
    </BoxContainer>
</controls:FancyWindow>
