<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'resource-extractor-window-title'}"
                      MinSize="420 270"
                      Resizable="False">
    <PanelContainer Name="TerminalBackground" HorizontalExpand="True" VerticalExpand="True">
    <BoxContainer Orientation="Vertical" Margin="10">
        <BoxContainer Orientation="Vertical" HorizontalExpand="True">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="21">
                <Label Name="StatusTitleLabel"
                       Text="{Loc 'resource-extractor-status-label'}"
                       StyleClasses="StatusFieldTitle"
                       MinWidth="130"
                       VerticalAlignment="Center" />
                <Label Name="StatusLabel"
                       HorizontalExpand="True"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            </BoxContainer>

            <BoxContainer Orientation="Horizontal" HorizontalExpand="True" MinHeight="21">
                <Label Name="FuelTitleLabel"
                       Text="{Loc 'resource-extractor-fuel-label'}"
                       StyleClasses="StatusFieldTitle"
                       MinWidth="130"
                       VerticalAlignment="Center" />
                <Label Name="FuelLabel"
                       HorizontalExpand="True"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
            </BoxContainer>

        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" Margin="0 8" />

        <Label Name="ProgressTitleLabel" Text="{Loc 'resource-extractor-progress-label'}" StyleClasses="monospace" />
        <Label Name="AsciiProgressLabel"
               StyleClasses="monospace"
               HorizontalAlignment="Center"
               Margin="0 4 0 0" />

        <Label Name="PendingLabel" StyleClasses="monospace" Margin="0 6 0 0" />

        <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 10 0 0">
            <Button Name="StartButton"
                    Text="{Loc 'resource-extractor-start'}"
                    TextAlign="Left"
                    HorizontalExpand="True" />
            <Button Name="StopButton"
                    Text="{Loc 'resource-extractor-stop'}"
                    TextAlign="Left"
                    HorizontalExpand="True"
                    Margin="0 4 0 0" />
            <Button Name="OpenOutputButton"
                    Text="{Loc 'resource-extractor-open-output'}"
                    TextAlign="Left"
                    HorizontalExpand="True"
                    Margin="0 4 0 0" />
            <Button Name="EjectFuelButton"
                    Text="{Loc 'resource-extractor-eject-fuel'}"
                    TextAlign="Left"
                    HorizontalExpand="True"
                    Margin="0 4 0 0" />
        </BoxContainer>
    </BoxContainer>
    </PanelContainer>
</controls:FancyWindow>
