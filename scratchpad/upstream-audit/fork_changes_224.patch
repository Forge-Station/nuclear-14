+        /// <summary>
+        /// Whitelist for entities that can go into the storage.
+        /// </summary>
+        [DataField]
+        public EntityWhitelist? Whitelist;
+
+        /// <summary>
+        /// Blacklist for entities that can go into storage.
+        /// </summary>
+        [DataField]
+        public EntityWhitelist? Blacklist;
+
+        /// <summary>
