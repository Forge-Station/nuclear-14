+        /// </summary>
+        [DataField]
+        public SoundSpecifier? StorageInsertSound = new SoundCollectionSpecifier("storageRustle");
+
+        /// <summary>
+        /// Sound played whenever an entity is removed from storage.
+        /// </summary>
+        [DataField]
+        public SoundSpecifier? StorageRemoveSound;
+
+        /// <summary>
