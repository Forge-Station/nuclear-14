+                                        },
+                                    },
+                                },
+                            },
+                        };
+
+                        parent.AddTab(category, Loc.GetString($"trait-category-{key}"));
+                    }
+                    // If the value is a dictionary, create a new tab for it and recursively call this function to fill it
